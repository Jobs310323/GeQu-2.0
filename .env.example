# Copy to .env.local and fill in. Same values go into Vercel's environment variables.

# Clerk → API Keys. Only the publishable key reaches the browser (VITE_ prefix).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Neon / Vercel Postgres connection string, used by the /api functions only.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
